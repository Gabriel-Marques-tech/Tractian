# Copiado para agent/.env por `make agent-env`.
# O .env.example nao veio no pacote da TRACTIAN, entao o target vinha quebrado.
#
# O agente usa modelo local por Ollama, entao nao ha chave de API a preencher.
# Estes valores tambem podem vir de experiment.json, que e a fonte preferida:
# o que muda o comportamento do modelo precisa chegar ao RunConfig e, por ele,
# ao trace.

OPENAI_API_KEY=nao-usado-com-ollama
AGENT_BASE_URL=http://localhost:11434
AGENT_MODEL=qwen2.5:1.5b
TRACTIAN_API=http://localhost:8000
AGENT_PORT=8001
